<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dgAguirreExamen.Views.vRegistro"
             Title="Registro">
    <ScrollView>
        <VerticalStackLayout 
            Spacing="10" 
            Padding="20">

            <Label x:Name="lblUsuario" />

            <Label Text="REGISTRO" TextColor="Blue" FontSize="22" HorizontalOptions="Center" />

            <Grid ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Label Text="Nombre" Grid.Row="0" Grid.Column="0" />
                <Label Text="Apellido" Grid.Row="0" Grid.Column="1" />
                <Label Text="Edad" Grid.Row="0" Grid.Column="2" />

                <Entry x:Name="txtNombre" Placeholder="Ingresar Nombre" Grid.Row="1" Grid.Column="0" />
                <Entry x:Name="txtApellido" Placeholder="Ingresar Apellido" Grid.Row="1" Grid.Column="1" />
                <Entry x:Name="txtEdad" Placeholder="Ingresar Edad" Keyboard="Numeric" Grid.Row="1" Grid.Column="2" />
            </Grid>

            <Grid RowSpacing="10" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Label Text="Fecha de inicio" Grid.Row="0" Grid.Column="0" />
                <DatePicker x:Name="dpFecha" Format="dd/MM/yyyy" Grid.Row="0" Grid.Column="1" />

                <Label Text="Plan" Grid.Row="1" Grid.Column="0" />
                <Picker x:Name="pkPlan" Title="Seleccione un plan" Grid.Row="1" Grid.Column="1" />

                <Label Text="Casillero" Grid.Row="2" Grid.Column="0" />
                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="10">
                    <Switch x:Name="swCasillero"
                            OnColor="Purple"
                            ThumbColor="White"
                            Toggled="swCasillero_Toggled" />
                    <Label x:Name="lblCasillero" Text="No" />
                </HorizontalStackLayout>

                <Label Text="Monto Inicial" Grid.Row="3" Grid.Column="0" />
                <Entry x:Name="txtMonto" Placeholder="Entre 120 y 600" Keyboard="Numeric" Grid.Row="3" Grid.Column="1" />

                <Button Text="Calcular Pago mensual" Grid.Row="4" Grid.Column="0" Clicked="btnCalcular_Clicked" />
                <Entry x:Name="txtPago" Placeholder="Pago mensual" IsReadOnly="True" Grid.Row="4" Grid.Column="1" />
            </Grid>

            <Button Text="Ver Resumen" Clicked="btnResumen_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>